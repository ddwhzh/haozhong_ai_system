# ============================================================
# HaoZhong Multi-Agent System — Environment Configuration
# ============================================================

# Application
APP_ENV=development
PROJECT_NAME="HaoZhong Multi-Agent System"
VERSION=0.1.0
DEBUG=true
API_PRESENTATION_MAX_WORKERS=4

# CORS
ALLOWED_ORIGINS=*

# ── LLM Configuration (OpenAI-compatible, 支持智谱GLM等) ────
OPENAI_API_KEY=your-api-key-here
OPENAI_API_BASE=https://open.bigmodel.cn/api/paas/v4/
DEFAULT_LLM_MODEL=glm-4-flash
DEFAULT_LLM_TEMPERATURE=0.2
MAX_TOKENS=4096
MAX_LLM_CALL_RETRIES=3

# Embedding
EMBEDDING_MODEL=embedding-3
EMBEDDING_DIMENSION=2048

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=HaoZhong_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_POOL_SIZE=20

# ── Neo4j Knowledge Graph ───────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j
NEO4J_DATABASE=neo4j
NEO4J_POOL_SIZE=50

# ── Vector Store ─────────────────────────────────────────────
VECTOR_COLLECTION_NAME=documents

# ── Langfuse Observability ───────────────────────────────────
LANGFUSE_PUBLIC_KEY=your-public-key
LANGFUSE_SECRET_KEY=your-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com

# ── Retrieval Agent ──────────────────────────────────────────
RETRIEVAL_MAX_SUB_QUERIES=5
RETRIEVAL_KG_MAX_HOPS=3
RETRIEVAL_CASCADE_ROUNDS=3
RETRIEVAL_TOP_K=10
RETRIEVAL_VECTOR_MODE=dense
RETRIEVAL_HYBRID_DENSE_WEIGHT=0.6
RETRIEVAL_HYBRID_SPARSE_WEIGHT=0.4
RETRIEVAL_HYBRID_RRF_K=60
RETRIEVAL_HYBRID_CANDIDATES=30
RETRIEVAL_HYBRID_MAX_TERMS=8
BRAVE_SEARCH_ENABLED=false
BRAVE_SEARCH_API_KEY=your-brave-search-api-key
BRAVE_SEARCH_BASE_URL=https://api.search.brave.com/res/v1/web/search
BRAVE_SEARCH_TOP_K=5
BRAVE_SEARCH_TIMEOUT_SECONDS=8
BRAVE_AUTO_INDEX_TO_VECTOR=false
BRAVE_AUTO_INDEX_MAX_ITEMS=3
BRAVE_AUTO_INDEX_MIN_CONTENT_CHARS=30
KEYWORD_EXTRACTION_USE_LLM=false
KEYWORD_EXTRACTION_MAX_TERMS=10

# ── Generation Agent ─────────────────────────────────────────
GENERATION_MAX_PROPOSALS=5
GENERATION_PROPOSAL_TEMPERATURE=0.3

# ── Evaluation Agent ─────────────────────────────────────────
EVALUATION_LLM=gpt-4o
EVALUATION_CONFIDENCE_THRESHOLD=0.7
EVALUATION_SPARSE_WEIGHT=0.3

# ── Pipeline ─────────────────────────────────────────────────
PIPELINE_MAX_ITERATIONS=10
HITL_ENABLED=true

# ── JWT / Auth ───────────────────────────────────────────────
JWT_SECRET_KEY=your-secret-key-here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_DAYS=30

# ── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
